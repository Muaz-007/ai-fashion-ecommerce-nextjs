# Database
# For local development with SQLite (zero setup):
DATABASE_URL="file:./prisma/dev.db"

# For PostgreSQL (production / Vercel):
# DATABASE_URL="postgresql://user:password@host:5432/maison_aurelle"

# Auth (used to sign session JWTs)
AUTH_SECRET="change-this-to-a-random-32-char-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI (powers admin insights, product auto-description, smart recommendations)
# Free tier: 1500 requests/day on gemini-2.0-flash. Get a key at https://aistudio.google.com/
# Optional — features fall back to rule-based logic if missing.
GEMINI_API_KEY=""
