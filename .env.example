# Database — PostgreSQL (Neon recommended: https://neon.tech)
# Get a free serverless Postgres connection string from your Neon project dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth (used to sign session JWTs — must be a random 32+ char string in production)
AUTH_SECRET="change-this-to-a-random-32-char-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Gemini AI (powers admin insights, product auto-description, smart recommendations)
# Free tier: 1500 requests/day on gemini-2.0-flash. Get a key at https://aistudio.google.com/
# Optional — features fall back to rule-based logic if missing.
GEMINI_API_KEY=""
